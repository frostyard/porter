# Porter's daemon, lodge's porter app (lodge's app-contract.md). It runs as
# its own system user, in group lodge-apps for inference and lodge-agents
# for the apps' MCP, never in group lodge, and listens on no network. Its
# configuration is /etc/porter/porter.json, and each app's token is in
# /var/lib/frostporter/tokens (porterd token set APP).
[Unit]
Description=Porter, behind lodge
Requires=frostporter.socket
After=frostporter.socket

[Service]
Type=exec
User=frostporter
Group=frostporter
SupplementaryGroups=lodge-apps lodge-agents
ExecStart=/usr/local/bin/porterd
StateDirectory=frostporter
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
